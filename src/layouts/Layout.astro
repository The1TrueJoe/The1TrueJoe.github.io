---
import Footer from "@components/general/Footer.astro";
import Navbar from "@components/general/Navbar.astro";

import "../styles/style.css";
---

<div class="relative min-h-screen bg-[#09090b]">
  <!-- Subtle grid -->
  <div class="fixed inset-0 bg-grid pointer-events-none z-0 opacity-60" aria-hidden="true"></div>
  <!-- Top radial vignette -->
  <div class="fixed inset-0 hero-vignette pointer-events-none z-0" aria-hidden="true"></div>

  <Navbar />
  <main class="container relative z-10">
    <slot />
  </main>
  <Footer />
</div>
