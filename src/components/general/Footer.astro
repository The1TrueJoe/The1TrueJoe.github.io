---
import { info } from "@data";
---

<footer class="relative z-10 border-t border-[#27272a] mt-24">
  <div class="container py-8 flex flex-col sm:flex-row items-center justify-between gap-4">

    <!-- Left -->
    <p class="font-inter text-xs text-[#3f3f46] order-2 sm:order-1">
      &copy; {new Date().getFullYear()} {info.name}
    </p>

    <!-- Social icons -->
    <div class="flex items-center gap-2 order-1 sm:order-2">
      <a aria-label="Resume" href={info.socialMedia.resume} target="_blank" rel="noopener noreferrer" class="footer-icons" title="Resume">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
      </a>
      <a aria-label="GitHub" href={info.socialMedia.github} target="_blank" rel="noopener noreferrer" class="footer-icons" title="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </svg>
      </a>
      <a aria-label="LinkedIn" href={info.socialMedia.linkedin} target="_blank" rel="noopener noreferrer" class="footer-icons" title="LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect x="2" y="9" width="4" height="12"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </a>
      <a aria-label="Email" href={`mailto:${info.socialMedia.email}`} class="footer-icons" title="Email">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </a>
    </div>

    <!-- Right: availability badge -->
    <div class="flex items-center gap-2 order-3">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#22c55e] opacity-60"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-[#22c55e]"></span>
      </span>
      <span class="font-mono text-[11px] text-[#3f3f46]">Open to opportunities</span>
    </div>

  </div>
</footer>
