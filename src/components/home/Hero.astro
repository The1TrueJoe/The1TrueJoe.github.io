---
import { IHeroProps } from "@types";
import { info } from "@data";

const { name, about } = Astro.props as IHeroProps;
---

<section class="min-h-[90vh] flex flex-col justify-center pt-8 pb-24">

  <!-- Mono label -->
  <p class="mono-label mb-6">Portfolio</p>

  <!-- Name -->
  <h1 class="main-heading mb-0">{name}</h1>

  <!-- Job title -->
  <div class="flex items-center gap-3 mt-5 mb-8">
    <span class="w-0.5 h-5 bg-[#22d3ee] rounded-full inline-block flex-shrink-0"></span>
    <p class="font-outfit text-base text-[#71717a] font-medium">{info.jobDescription}</p>
  </div>

  <!-- About -->
  <p class="font-inter text-[15px] text-[#71717a] leading-relaxed max-w-2xl mb-10">
    {about}
  </p>

  <!-- CTA row -->
  <div class="flex flex-wrap items-center gap-3 mb-12">
    <a href={info.socialMedia.github} target="_blank" rel="noopener noreferrer" class="btn-primary">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
      </svg>
      GitHub
    </a>
    <a href={info.socialMedia.linkedin} target="_blank" rel="noopener noreferrer" class="btn-outline">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
        <rect x="2" y="9" width="4" height="12"></rect>
        <circle cx="4" cy="4" r="2"></circle>
      </svg>
      LinkedIn
    </a>
    <a href={`mailto:${info.socialMedia.email}`} class="btn-outline">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
      Email
    </a>
    <a href={info.socialMedia.resume} target="_blank" rel="noopener noreferrer" class="btn-ghost">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
      </svg>
      Resume
    </a>
  </div>

  <!-- Scroll hint -->
  <div class="flex items-center gap-3">
    <div class="h-px w-12 bg-[#27272a]"></div>
    <span class="mono-label text-[#3f3f46] tracking-widest">scroll</span>
  </div>

</section>
