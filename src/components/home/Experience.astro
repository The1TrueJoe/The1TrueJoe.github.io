---
import { IExperiences } from "@types";

const { title, details } = Astro.props as IExperiences;
---

<section class="mt-24">
  <!-- Section header -->
  <div class="section-header">
    <span class="mono-label">{title}</span>
    <div class="flex-1"></div>
    <span class="font-mono text-[11px] text-[#3f3f46]">{details.length} entries</span>
  </div>

  <!-- Entries -->
  <div class="space-y-4">
    {
      details.map((item) => (
        <div class="v0-card overflow-hidden">
          <!-- Optional image banner -->
          {item.image && (
            <div class="relative h-36 overflow-hidden rounded-t-xl">
              <img
                src={item.image}
                alt={item.name}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 img-overlay rounded-t-xl"></div>
            </div>
          )}

          <div class="p-5">
            <!-- Header row -->
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="font-outfit font-semibold text-[15px] text-[#e4e4e7] leading-snug">
                  {item.name}
                </h3>
                <div class="flex items-center gap-2 mt-1 flex-wrap">
                  <span class="font-inter text-xs text-[#22d3ee]">{item.location}</span>
                  <span class="text-[#3f3f46] text-xs">·</span>
                  <span class="font-mono text-[11px] text-[#71717a]">
                    {item.startDate} — {item.endDate}
                  </span>
                </div>
              </div>
            </div>

            <!-- Divider -->
            <div class="w-full h-px bg-[#27272a] mb-4"></div>

            <!-- Description -->
            <ul class="space-y-2 mb-4">
              {item.description.map((line) => (
                <li class="flex items-start gap-2.5 text-[13px] text-[#71717a] leading-relaxed">
                  <span class="text-[#3f3f46] mt-0.5 flex-shrink-0 font-mono">–</span>
                  <span class="font-inter">{line.replace(/^- /, "")}</span>
                </li>
              ))}
            </ul>

            <!-- Tags -->
            {item.tags && item.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 pt-3 border-t border-[#27272a]">
                {item.tags.map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>
