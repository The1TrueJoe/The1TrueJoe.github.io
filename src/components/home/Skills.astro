---
export interface Props {
  title: string;
  skills: {
    software: string[];
    tooling: string[];
    embedded: string[];
    memberships: string[];
  };
}

const { title, skills } = Astro.props;

const groups: { label: string; items: string[]; chipClass: string }[] = [
  { label: "Languages & Software", items: skills.software,    chipClass: "chip-cyan" },
  { label: "Tooling & EDA",        items: skills.tooling,     chipClass: "chip-purple" },
  { label: "Embedded / OS",        items: skills.embedded,    chipClass: "chip-amber" },
  { label: "Memberships",          items: skills.memberships, chipClass: "chip-green" },
];
---

<section class="mt-24">
  <!-- Section header -->
  <div class="section-header">
    <span class="mono-label">{title}</span>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    {
      groups.map((group) => (
        <div class="v0-card p-5">
          <!-- Group header -->
          <div class="flex items-center gap-2 mb-4 pb-3 border-b border-[#27272a]">
            <span class="mono-label text-[#a1a1aa]">{group.label}</span>
          </div>

          <!-- Chips -->
          <div class="flex flex-wrap gap-1.5">
            {group.items.map((skill) => (
              <span class={group.chipClass}>{skill}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>