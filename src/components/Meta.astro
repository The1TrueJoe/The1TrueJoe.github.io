---
import site from "@data/site.json";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Set on writeups and notes so link previews read as articles. */
  type?: "website" | "article";
}

const { title, description, ogImage, type = "website" } = Astro.props;

const pageTitle = title === site.name ? site.name : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

/* There is no share image until one is set — in Site details, or per writeup.
   Rather than point previews at a missing file, drop the image tags and fall
   back to the small card, which renders correctly without one. */
const share = ogImage || site.ogImage;
const image = share ? new URL(share, Astro.site) : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={site.name} />
{image && <meta property="og:image" content={image} />}

<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}

<meta name="theme-color" content="#f3f2f2" />

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#ec3013" />
<link rel="manifest" href="/site.webmanifest" />

<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/assets/fonts/Archivo/Archivo-latin.woff2"
  crossorigin
/>
