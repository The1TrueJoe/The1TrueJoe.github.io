---
interface Props {
  items: string[];
  /** `accent` is reserved for the one tag that names the thing itself. */
  variant?: "outline" | "accent" | "neutral";
  class?: string;
}

const { items, variant = "outline", class: className } = Astro.props;
---

{
  items.length > 0 && (
    <div class:list={["tags", className]}>
      {items.map((item) => (
        <span class:list={["tag", `tag-${variant}`]}>{item}</span>
      ))}
    </div>
  )
}
