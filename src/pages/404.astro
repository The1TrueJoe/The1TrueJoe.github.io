---
import Base from "@layouts/Base.astro";
---

<Base title="Not found" description="That page does not exist.">
  <section class="article-head">
    <div class="eyebrow" style="margin-bottom: 20px">Error 404</div>
    <h1>NOT FOUND</h1>
    <p class="article-head__lede">That page does not exist — or it did, and no longer does.</p>
    <nav class="article-nav">
      <a class="btn btn-primary" href="/">Back to the start →</a>
      <a class="btn btn-secondary" href="/#work">Selected work</a>
      <a class="btn btn-secondary" href="/notes">Notes</a>
    </nav>
  </section>
</Base>
