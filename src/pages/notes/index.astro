---
import { getCollection } from "astro:content";

import Base from "@layouts/Base.astro";
import Tags from "@components/Tags.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

/* Dates are authored as plain `YYYY-MM-DD` and parsed as UTC midnight, so format
   them in UTC too — otherwise anywhere west of Greenwich renders the day before. */
const formatted = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });

const description =
  "Notes on hardware, firmware, and the systems behind them — written as they happen.";
---

<Base title="Notes" description={description} current="notes">
  <section class="article-head">
    <div class="eyebrow" style="margin-bottom: 20px">Writing</div>
    <h1>NOTES</h1>
    <p class="article-head__lede">{description}</p>
  </section>

  <section style="padding-top: 40px">
    {
      notes.length === 0 ? (
        <p class="text-muted">Nothing published yet.</p>
      ) : (
        notes.map((note) => (
          <article class="note-row">
            <div class="entry__when">
              <time datetime={note.data.date.toISOString()}>{formatted(note.data.date)}</time>
            </div>
            <div>
              <h3>
                <a href={`/notes/${note.id}`}>{note.data.title}</a>
              </h3>
              <p>{note.data.summary}</p>
              <Tags items={note.data.tags} class="entry-tags" />
            </div>
          </article>
        ))
      )
    }
  </section>
</Base>

<style>
  .note-row :global(.entry-tags) {
    gap: 6px;
    margin-top: var(--space-3);
  }
</style>
