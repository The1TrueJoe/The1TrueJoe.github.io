---
import { info } from "@data";

import ProjectsWrapper from "@components/general/ProjectsWrapper.astro";
import MetaHead from "@components/general/MetaHead.astro";
import Layout from "@layouts/Layout.astro";

const Projects = info.projects.map((project) => project);
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <MetaHead
      title={"Projects and Work"}
      description={"All projects and work are available in this page."}
      ogImageUrl={"/assets/images/profile.png"}
    />
  </head>

  <body>
    <Layout>
      <div class="pt-16 pb-10">
        <p class="mono-label mb-6">Work</p>
        <h1 class="main-heading">Projects</h1>
        <p class="font-inter text-[15px] text-[#71717a] mt-4 max-w-xl leading-relaxed">
          Hardware, firmware, and software &mdash; from PCB to cloud.
        </p>
      </div>
      <ProjectsWrapper projects={Projects} />
    </Layout>
  </body>
</html>
